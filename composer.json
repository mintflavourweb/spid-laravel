{
  "name": "mintflavourweb/spid-laravel",
  "description": "Laravel Package for SPID authentication",
  "keywords": [
    "SPID",
    "Laravel",
    "PHP"
  ],
  "homepage": "https://github.com/mintflavourweb/spid-laravel",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Davide Porrovecchio - Agenzia per l'Italia Digitale",
      "email": "davide.porrovecchio@agid.gov.it"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/config": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "onelogin/php-saml": "^4.3.2",
    "nesbot/carbon": "^2.66 || ^3.0"
  },
  "require-dev": {
    "pds/skeleton": "~1.0",
    "phpunit/phpunit": "^12.5.8",
    "orchestra/testbench": "^11.2",
    "mockery/mockery": "^1.6.10",
    "mikey179/vfsstream": "^1.6",
    "friendsofphp/php-cs-fixer": "^3.88"
  },
  "autoload": {
    "psr-4": {
      "Italia\\SPIDAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Italia\\SPIDAuth\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Italia\\SPIDAuth\\ServiceProvider"
      ]
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/certs",
      ".editorconfig",
      "php_cs.dist"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
